{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Your Story",
  "version": "0.1.0",
  "identifier": "com.yourstory.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "NEXT_PUBLIC_STANDALONE=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Your Story",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
